{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "checkJs": false
  },
  "include": [
    "src/**/*",
    "vite.config.js",
    "tailwind.config.js",
    "vitest.config.js",
    "playwright.config.js"
  ],
  "exclude": ["node_modules", "dist"]
}
