# ==============================================================================
# RoadCare Environment Variables Template
# Copy this file to .env for local development.
# Configure these variables in your Vercel Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / PUBLIC (Vite Client-Side)
# Values prefixed with VITE_ are bundled into client-side JavaScript.
# NEVER put private keys (service-role keys, DB passwords) with VITE_ prefix.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Optional: Custom API URL. Leave blank or omitted to use relative /api routing on Vercel:
# VITE_API_URL=""

# Optional: Local development only - enable 1-click demo personas in Vite dev mode (strictly disabled in production):
# VITE_ENABLE_DEV_DEMO="false"

# ------------------------------------------------------------------------------
# 2. BACKEND / SERVER-SIDE (Vercel Serverless Functions & apps/api)
# Privileged credentials - NEVER commit to git or expose to the browser.
# ------------------------------------------------------------------------------
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Optional: External AI Microservice (FastAPI hosted on Railway, Render, Fly.io, etc.)
# If omitted or offline, AI analysis reports unavailable and manual complaint submission proceeds seamlessly:
# ROAD_DAMAGE_AI_URL="http://localhost:8000"
# AI_SERVICE_URL="http://localhost:8000"

# Server configuration
# PORT=5000
# NODE_ENV="production"
# WEB_ORIGIN="https://your-app.vercel.app"
