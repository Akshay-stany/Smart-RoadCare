# RoadCare web app (Vite). Only PUBLIC values belong here — anything prefixed VITE_ is
# bundled into the browser. NEVER put a Supabase service-role key in this file.

# Supabase project URL (Project Settings -> API)
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# Supabase anon / publishable key (safe for browsers; access is controlled by RLS)
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
# Supabase project reference id
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"
