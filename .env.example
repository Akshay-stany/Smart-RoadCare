# ==============================================================================
# RoadCare Environment Variables Template
# Copy this file to .env for local development.
# Configure these variables in your Vercel Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / PUBLIC (Vite)
# Values prefixed with VITE_ are bundled into client-side JavaScript.
# NEVER put private keys (service-role keys, DB passwords) with VITE_ prefix.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Optional: Custom API URL. Leave blank or omitted to use relative /api routing on Vercel:
# VITE_API_URL=""

# ------------------------------------------------------------------------------
# 2. BACKEND / SERVER-SIDE (Vercel Serverless & apps/api)
# Privileged credentials - NEVER commit to git or expose to browser.
# ------------------------------------------------------------------------------
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Optional: External AI Microservice (FastAPI on Railway, Render, Fly.io, etc.)
# If omitted, Express API falls back to built-in deterministic road defect detection:
# ROAD_DAMAGE_AI_URL="http://localhost:8000"
# AI_SERVICE_URL="http://localhost:8000"

